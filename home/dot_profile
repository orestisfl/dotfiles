# POSIX-sh profile. ly runs `/bin/sh -l` before `exec sway`, so this is the
# earliest place to set env for the GUI session. Source the same env.d files
# the systemd user instance loaded -- they're shell-compatible KEY=VALUE
# with $VAR expansion -- so sway and everything it spawns sees the same
# static env (PATH, EDITOR, ...) without needing per-file duplication.

set -a
for _f in "$HOME"/.config/environment.d/*.conf; do
    [ -r "$_f" ] && . "$_f"
done
set +a
unset _f
