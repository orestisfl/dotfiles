#!/usr/bin/env bash
# org.gnome.desktop.* drives GTK look-and-feel on Wayland (sway): the settings
# portal serves these keys to apps, overriding ~/.config/gtk-3.0. color-scheme
# also reaches GTK4/libadwaita/Electron via the portal on X11, so this runs on
# every host. Native theming for X11 apps comes from xsettingsd instead (see
# .config/xsettingsd/), since GDK-X11 reads XSettings, not these keys.
#
# Values come from .chezmoidata.toml, shared with the xsettingsd config.
# libadwaita GTK4 apps ignore gtk-theme; vanilla GTK4 has no adw-gtk3 gtk-4.0
# css so it falls back to default Adwaita, which honors color-scheme.
set -euo pipefail

command -v gsettings >/dev/null || exit 0
# gsettings needs a session bus; skip silently in chroot / image builds.
[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || exit 0

gsettings set org.gnome.desktop.interface color-scheme {{ .gtk.colorScheme | quote }}
gsettings set org.gnome.desktop.interface gtk-theme {{ .gtk.theme | quote }}
gsettings set org.gnome.desktop.interface icon-theme {{ .gtk.iconTheme | quote }}
gsettings set org.gnome.desktop.interface cursor-theme {{ .gtk.cursorTheme | quote }}
gsettings set org.gnome.desktop.interface cursor-size {{ .gtk.cursorSize }}
gsettings set org.gnome.desktop.wm.preferences button-layout {{ .gtk.buttonLayout | quote }}
