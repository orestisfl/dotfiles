{{/*
  Per-host scoping. Prefer a `.tmpl` with a role guard over an entry here;
  chezmoi skips files whose template renders empty.
*/}}

{{- if not .xorg }}
.config/i3
{{- end }}

{{- if not .wayland }}
.config/sway
.config/ironbar
{{- end }}

{{- /* X11-only files on wayland hosts. */}}
{{- if .wayland }}
.Xresources
.config/colors.xres
.config/systemd/user/x11-session.target
.config/systemd/user/xsettingsd.service
.config/xft.xres
.config/xsettingsd
.local/bin/i3-get-window-criteria.sh
.xbindkeysrc
.xinitrc
start-xephyr.sh
{{- end }}

{{- /* Repo / editor / build metadata at any depth. */}}
**/.clang-format
**/.git
**/.gitignore
**/.idea
**/*.gz
**/LICENSE
**/README.md
**/__pycache__
**/compile_commands.json

{{- if not .elastic }}
.config/firejail/zoom.local
{{- end }}

{{- /* Managed out-of-band, not from this repo. */}}
.config/systemd/user/gh-notifications-filter*
{{- /* `systemctl --user enable/disable` owns the *.target.wants/ symlinks; */}}
.config/systemd/user/*.target.wants

{{- /* Installed by run_onchange_after_60-yazi-plugins from package.toml; */}}
{{- /* only local (non-package) plugins live in the source.               */}}
.config/yazi/plugins/*
!.config/yazi/plugins/smart-switch.yazi

