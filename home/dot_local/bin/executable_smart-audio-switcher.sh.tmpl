{{- if eq .chezmoi.hostname "carbon" -}}
#!/bin/bash
# Routes audio on device changes: Bluetooth > HDMI monitor matching
# $HDMI_MONITOR_NAME > laptop speakers, plus a preferred mic. Runs as
# smart-audio-switcher.service, driven by `pactl subscribe`.

# Matches both the legacy ACP name and the UCM name for the onboard card.
SOUND_CARD_NAME_PATTERN="alsa_card.pci-0000_00_1f.3"
SINK_PREFIX="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"

# Matched against each HDMI port's device.product.name (from the monitor's
# ELD). Stable across GPU port swaps, unlike HDMIN indices.
HDMI_MONITOR_NAME="LG"

SPEAKER_PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
SPEAKER_SINK="${SINK_PREFIX}.HiFi__Speaker__sink"

# Substring patterns for preferred mic sources, in priority order. Using a
# stable tail (e.g. "HiFi__Mic1__source") survives card renames. Monitor
# sources (".monitor") are always excluded.
KNOWN_GOOD_MIC_PATTERNS=(
    "HiFi__Mic1__source"
)

# Move streams of $kind (sink|source) from one device to another (both by
# name). Streams routed to any other device are left alone, as a best-effort
# heuristic for preserving manual routing (PipeWire has no "pinned" flag we
# can read).
move_streams() {
    local kind=$1 from=$2 to=$3 stream from_id id
    [[ -z $from || $from == "$to" ]] && return 0
    [[ $kind == sink ]] && stream="sink-input" || stream="source-output"

    from_id=$(pactl list short "${kind}s" | awk -v n="$from" '$2==n {print $1; exit}')
    [[ -z $from_id ]] && return 0

    for id in $(pactl list short "${stream}s" | awk -v s="$from_id" '$2==s {print $1}'); do
        if pactl "move-$stream" "$id" "$to" >/dev/null 2>&1; then
            echo "Moved $stream #$id: $from -> $to"
        else
            echo "WARN: Failed to move $stream #$id to $to" >&2
        fi
    done
}

# Make $name the default $kind (sink|source) and migrate streams from the
# previous default so audio follows the route. pipewire-pulse stores this as
# WirePlumber's configured default, so it persists.
set_default() {
    local kind=$1 name=$2 prev
    prev=$(pactl "get-default-$kind")
    [[ $prev == "$name" ]] && return 0
    pactl "set-default-$kind" "$name" || return
    echo "Default $kind: $prev -> $name"
    move_streams "$kind" "$prev" "$name"
}

ensure_profile() {
    local profile=$1 card active
    read -r card active < <(pactl -f json list cards | jq -r --arg p "$SOUND_CARD_NAME_PATTERN" \
        'first(.[] | select(.name | contains($p)) | "\(.name) \(.active_profile)")')
    if [[ -z $card ]]; then
        echo "WARN: No sound card matching '$SOUND_CARD_NAME_PATTERN' yet" >&2
        return 1
    fi
    [[ $active == "$profile" ]] && return 0
    echo "Switching card profile: '$active' -> '$profile'."
    pactl set-card-profile "$card" "$profile"
}

# Print the onboard card's preferred plugged-in output port: the HDMI port
# (e.g. "HDMI1") whose monitor matches $HDMI_MONITOR_NAME, else "Headphones",
# else nothing.
get_wired_port() {
    pactl -f json list cards | jq -r \
        --arg p "$SOUND_CARD_NAME_PATTERN" --arg m "$HDMI_MONITOR_NAME" '
        first(.[] | select(.name | contains($p))) | .ports | to_entries
        | map(select(.value.availability == "available"))
        | map(select(.value.properties["device.product.name"] // "" | contains($m))
              | .key | match("HDMI[0-9]+").string)
          + map(select(.key == "[Out] Headphones") | "Headphones")
        | first // empty'
}

# Print the sink to use: Bluetooth > HDMI ($HDMI_MONITOR_NAME) > headphones >
# speakers. Headphones live on a separate card profile, so they must win over
# the speaker fallback, which forces the speaker profile.
pick_sink() {
    local sink port
    sink=$(pactl list short sinks | awk '$2 ~ /bluez_output/ {print $2; exit}')
    if [[ -z $sink ]]; then
        port=$(get_wired_port)
        sink=${port:+${SINK_PREFIX}.HiFi__${port}__sink}
    fi
    echo "${sink:-$SPEAKER_SINK}"
}

# First non-monitor source matching KNOWN_GOOD_MIC_PATTERNS in priority order.
pick_mic() {
    local sources pattern
    sources=$(pactl list short sources | awk '$2 !~ /\.monitor$/ {print $2}')
    for pattern in "${KNOWN_GOOD_MIC_PATTERNS[@]}"; do
        grep -F -m1 -- "$pattern" <<<"$sources" && return 0
    done
    return 1
}

# Apply a pick only when it differs from the last one applied: events fire on
# volume changes too, and re-applying would undo a manual default.
picked_sink="" picked_mic=""
route() {
    local sink mic
    sink=$(pick_sink)
    if [[ $sink != "$picked_sink" ]]; then
        if [[ $sink != "$SPEAKER_SINK" ]] || ensure_profile "$SPEAKER_PROFILE"; then
            set_default sink "$sink" && picked_sink=$sink
        fi
    fi
    # Without a known-good mic, leave the default alone (e.g. a user-picked
    # USB headset not in the whitelist).
    if mic=$(pick_mic) && [[ $mic != "$picked_mic" ]]; then
        set_default source "$mic" && picked_mic=$mic
    fi
}

# BT connects, HDMI hotplugs and profile switches arrive as new/remove events
# on sinks and sources or change events on cards. Re-route after each burst.
pactl subscribe | {
    route
    while read -r event; do
        case $event in
        *" on card #"* | *"'new' on sink #"* | *"'remove' on sink #"* | \
            *"'new' on source #"* | *"'remove' on source #"*) ;;
        *) continue ;;
        esac
        # Wait for the burst to settle, bounded since unrelated events (e.g.
        # other pactl clients) can keep arriving.
        deadline=$((SECONDS + 3))
        while ((SECONDS < deadline)) && read -r -t 1 _; do :; done
        route
    done
}
{{- end -}}
