#!/bin/bash
# i3-rofi-actions
# Use rofi to call systemctl for shutdown, reboot, etc
set -euo pipefail

declare -A options
declare -a options_order

have() {
    command -v "$1" >/dev/null 2>&1
}

add_option_if_file() {
    if [[ -f "$2" ]]; then
        add_option "$1" "$2"
    fi
}

add_option() {
    options["$1"]="$2"
    options_order+=("$1")
}

switch_autorandr() {
    autorandr --change --debug --default solo
}
export -f switch_autorandr

# LG HDR 4K: find its HDMI connector in sysfs. Sets lg_bus (I2C bus number)
# and lg_port (1 or 2) from the HDMI physical address in the EDID: the LG
# reports 1.0.0.0 on HDMI1 and 2.0.0.0 on HDMI2.
lg_find() {
    local c hex
    for c in /sys/class/drm/card*-HDMI-*; do
        [[ -e "$c/ddc" && "$(<"$c/status")" == connected ]] || continue
        grep -qa 'LG HDR 4K' "$c/edid" || continue
        hex="$(od -An -v -tx1 "$c/edid" | tr -d '\n')"
        [[ "$hex" =~ \ 03\ 0c\ 00\ ([12]) ]] || continue
        lg_port="${BASH_REMATCH[1]}"
        lg_bus="$(readlink -f "$c/ddc")"
        lg_bus="${lg_bus##*/i2c-}"
        return 0
    done
    return 1
}

# The LG only answers DDC/CI on the input it is showing. Dynamic sleep is off:
# it would read those failures as a slow monitor, and the longer waits it saves
# in ~/.cache/ddcutil/dsa would slow later calls on this bus. A fixed 0.1 sleep
# multiplier keeps a probe at ~65ms (the standard waits take ~430ms).
lg_ddc() {
    ddcutil --bus "$lg_bus" --disable-dynamic-sleep --sleep-multiplier 0.1 --maxtries .,3,. "$@"
}

lg_active() {
    lg_ddc getvcp 60 >/dev/null 2>&1
}

# Hand the LG to the other HDMI input via LG's DDC/CI side channel
# (xF4 from source x50: x90 = HDMI1, x91 = HDMI2, xD0 = DP-1, xD1 = DP-2,
# xD2 = USB-C). Losing DDC afterwards confirms the switch. Under sway also
# disable the LG so its workspaces move to the other outputs.
switch_monitor_input() {
    local target=$((3 - lg_port))

    lg_ddc setvcp xf4 "x009$((target - 1))" --i2c-source-addr=x50 --noverify || return
    for _ in 1 2 3 4 5 6; do
        sleep 0.5
        lg_active && continue
        if [[ -n "${SWAYSOCK:-}" ]]; then
            swaymsg output '"LG Electronics LG HDR 4K 301MAKRKFW57"' disable
        fi
        return 0
    done

    echo "LG HDR 4K did not switch to HDMI$target." >&2
    return 1
}
export -f switch_monitor_input

ddcutil_brightness() {
    value="$(yad --entry --entry-text="$(ddcutil --model 'LG HDR 4K' getvcp 10 --brief | cut -d ' ' -f 4)")"
    [[ -n "$value" ]] || return 0

    (light -S "$value" || true) &
    (ddcutil --model 'LG HDR 4K' setvcp 10 "$value" || true) &
    ddcutil --model 'HP E27d G4' setvcp 10 "$value" || true
    wait
}
export -f ddcutil_brightness

# Wrap bluetoothctl so a stuck bluetoothd/controller can't hang rofi.
btctl() {
    timeout 5s bluetoothctl "$@"
}
export -f btctl

bluetooth_on() {
    # bluetooth.service drop-in modprobes btusb in ExecStartPre.
    systemctl is-active bluetooth >/dev/null 2>&1 || systemctl start bluetooth >/dev/null 2>&1 || true

    local powered=false
    for i in {0..4}; do
        if btctl power on 2>&1 | grep -q "Changing power on\|succeeded"; then
            powered=true
            break
        fi
        sleep 1
    done

    $powered || {
        echo "Failed to power on bluetooth adapter" >&2
        return 1
    }
    sleep 1

    for i in {0..2}; do
        mapfile -t trusted_ids < <(btctl devices Trusted | awk '{print $2}')
        for id in "${trusted_ids[@]}"; do
            [[ -n "$id" ]] || continue
            btctl connect "$id" && return 0 || true
        done
        sleep 1
    done

    have blueman-manager && {
        blueman-manager &
        disown
    }
}
export -f bluetooth_on

bluetooth_off() {
    mapfile -t connected_ids < <(btctl devices Connected | awk '{print $2}')
    for id in "${connected_ids[@]}"; do
        [[ -n "$id" ]] || continue
        btctl disconnect "$id" || true
    done

    btctl power off || true
    # bluetooth.service drop-in unloads btusb in ExecStopPost.
    systemctl stop bluetooth.service >/dev/null 2>&1 || true
    killall blueman-applet blueman-tray blueman-manager || true
}
export -f bluetooth_off

run_action() {
    local action="$1"

    if declare -F "$action" >/dev/null; then
        "$action"
        return
    fi

    if [[ -f "$action" ]]; then
        "$action"
        return
    fi

    bash -lc "$action"
}

wt_clipboard="$HOME/.local/bin/wt-clipboard.py"
if [[ -x "$wt_clipboard" ]] && wt_label="$("$wt_clipboard" --check 2>/dev/null)" && [[ -n "$wt_label" ]]; then
    add_option "$wt_label" "$wt_clipboard"
fi

have gcalcli && ! pidof zoom >/dev/null 2>&1 && add_option "Join zoom meeting" "$HOME/.local/bin/join-zoom.sh"
pidof zoom >/dev/null 2>&1 && add_option_if_file "Kill zoom" "$HOME/.local/share/i3-rofi-actions.ignored.sh"

add_option_if_file "Rename workspace" "$HOME/.local/bin/i3-workspace-rename.py"
have bluetoothctl &&
    add_option "Bluetooth on" "bluetooth_on" &&
    add_option "Bluetooth off" "bluetooth_off"

# networkmanager_dmenu spawns its own rofi; works under sway and i3 alike.
have networkmanager_dmenu && add_option "Wi-Fi / network" "networkmanager_dmenu"

# Airplane mode (laptops): reversible battery-saving profile + networking off.
if have tlp; then
    if "$HOME/.local/bin/airplane-mode" status >/dev/null 2>&1; then
        add_option "Airplane mode off" "$HOME/.local/bin/airplane-mode off"
    else
        add_option "Airplane mode on" "$HOME/.local/bin/airplane-mode on"
    fi
fi

if [[ -n "${SWAYSOCK:-}" ]]; then
    if "$HOME/.local/bin/sway-idle" relaxed; then
        add_option "Enable auto-lock" "$HOME/.local/bin/sway-idle secure"
    else
        add_option "Disable auto-lock" "$HOME/.local/bin/sway-idle relax"
    fi
    add_option "Sleep monitor" "$HOME/.local/bin/sway-idle off-now"
    add_option "Exit" "swaymsg exit"
else
    add_option "Sleep monitor" "xset dpms force suspend; sleep 0.1; xset dpms force suspend"
    add_option "Exit" "i3-msg exit"
fi
add_option "Suspend system" "systemctl suspend"
add_option "Reboot system" "systemctl reboot"
add_option "Power-off system" "systemctl poweroff"

# External-display helpers (ddcutil is display-server independent; autorandr is
# X11 only). Detect an external output in either compositor.
if [[ -n "${SWAYSOCK:-}" ]]; then
    external_connected() {
        swaymsg -t get_outputs 2>/dev/null |
            jq -e '[.[] | select(.active and (.name | test("^(DP|HDMI)-"))) ] | length > 0' \
                >/dev/null 2>&1
    }
else
    have autorandr && add_option "Autorandr" switch_autorandr
    external_connected() {
        have xrandr && xrandr | grep -Eq '\b(DP|HDMI)-[0-9]+ connected'
    }
fi

if external_connected; then
    add_option "Change external monitor brightness" ddcutil_brightness
fi

# Only offered when the LG is showing this host. rofi reads stdin
# asynchronously, so the entry is appended once the DDC probe answers
# instead of delaying the menu.
lg_label=
if lg_find; then
    lg_label="Switch monitor to HDMI$((3 - lg_port))"
    options["$lg_label"]=switch_monitor_input
fi

lines=${#options_order[@]}
[[ -n "$lg_label" ]] && lines=$((lines + 1))
printf '%s\n' "${options_order[@]}"

selection="$(
    rofi -matching fuzzy -l "$lines" -dmenu -i -p 'Pick action: ' < <(
        printf '%s\n' "${options_order[@]}"
        [[ -n "$lg_label" ]] && lg_active && printf '%s\n' "$lg_label"
    ) | tr -d '\r\n'
)"

[[ -n "$selection" ]] || exit 0
action="${options[$selection]:-}"
[[ -n "$action" ]] || exit 0

out="$(run_action "$action" 2>&1)" ||
    yad --title="$selection" --image=dialog-error --text="Command failed: $out" \
        --no-markup --selectable-labels --button=OK:0
