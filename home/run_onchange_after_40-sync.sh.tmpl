#!/usr/bin/env bash
{{- range (glob (joinPath .chezmoi.sourceDir ".." "sync" "*.txt.tmpl")) }}
# manifest:  {{ include . | sha256sum }} {{ base . }}
{{- end }}
{{- range (glob (joinPath .chezmoi.sourceDir ".." "sync" "**" "*.py")) }}
# sync code: {{ include . | sha256sum }} {{ base . }}
{{- end }}
{{- range (glob (joinPath .chezmoi.sourceDir "dot_local/share/root-staging/**/*")) }}
{{- if not (stat .).isDir }}
# etc:       {{ include . | sha256sum }} {{ base . }}
{{- end }}
{{- end }}
set -euo pipefail

# Single entry point: plans packages + etc + units + defaults for this host
# and pops one yad to confirm the chained shell command. Manifest syntax
# errors abort the apply; an empty plan is a silent no-op.
python3 "{{ .chezmoi.sourceDir }}/../sync/sync.py" gui
