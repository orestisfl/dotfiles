configuration {
    ssh-command: "{terminal} -e {ssh-client} {host} [-p {port}]";
    run-shell-command: "{terminal} -e {cmd}";
    run-command: "app-scope {cmd}";
    /* drun defaults to GIO launch, which ignores run-command. */
    drun {
        gio-launch: false;
    }
    kb-select-1: "";
    kb-select-2: "";
    kb-select-3: "";
    kb-select-4: "";
    kb-select-5: "";
    kb-select-6: "";
    kb-select-7: "";
    kb-select-8: "";
    kb-select-9: "";
    kb-select-10: "";
    terminal: "ghostty";

    dpi: 1;
}
