[user]
	name = Orestis Floros
	useConfigOnly = true
[format]
	pretty = oneline
[pretty]
	line = "tformat:%C(auto)%h%d %s %C(dim)%an, %ar%C(reset)"
[credential]
	helper = libsecret
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoUpdate = true
[alias]
	b = "!f() { git checkout ${1:-$(git for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short)' | fzf)}; }; f"
	bD = branch -D
	bclean = "!f() { git fetch --all --prune; gone=$(git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}'); [ -n \"$gone\" ] && git branch -D $gone || echo 'No gone branches'; }; f"
	lg = log --graph --pretty=line
	lga = lg --all
	lb = "!git lg $(git upstream-ref)..HEAD"
	hist = ld --follow
	lf = log --pretty=fuller --decorate --stat
	ld = lf -p
	s = status -sb
	c = commit --verbose
	fzf = "!f() { sha=$(git log --pretty=oneline --color=always | fzf --ansi | awk '{print $1}') && [ -n \"$sha\" ] && git show $sha; }; f"
	last = "!f() { git lf -1 ${1-HEAD}; }; f"
	rpr = "!git rebase -i --keep-base $(git upstream-ref)"
	ror = "!git fetch && git rebase $(git upstream-ref)"
	aa = "!f() { git add -p && git commit --amend --no-edit; }; f"
	ac = "!f() { git add -p && { if [ -z \"$1\" ]; then git commit; else git commit -m \"$1\"; fi; }; }; f"
	acp = "!f() { git add -p && { if [ -z \"$1\" ]; then git commit; else git commit -m \"$1\"; fi; } && git rev-parse --short=12 HEAD && git push; }; f"
	fif = push --force-if-includes --force-with-lease
	cb = "!f() { if [ -n \"$(git for-each-ref \"refs/heads/$1\" \"refs/remotes/*/$1\")\" ]; then git switch \"$1\"; else git switch -c \"$1\"; fi; }; f"
	chp = checkout -p
	d = diff \
		--word-diff=color \
		--word-diff-regex='([0-9@A-Za-z]+|[^0-9@A-Za-z()]+|[()])'
	print-home = rev-parse --show-toplevel
[grep]
	extendRegexp = true
	lineNumber = true
[url "https://aur.archlinux.org/"]
	insteadOf = aur://
[commit]
	verbose = true
	gpgsign = true
[tag]
	gpgSign = true
	sort = version:refname
[branch]
	sort = -committerdate
[column]
	ui = auto
[help]
	autocorrect = prompt
[color "diff"]
	meta = yellow
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[core]
	pager = delta
	attributesfile = ~/.config/git/gitattributes
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	syntax-theme = gruvbox-dark
[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
[fetch]
	prune = true
	all = true
[pull]
	rebase = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[push]
	autoSetupRemote = true
	followTags = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# Per-host identity (untracked). Last so it can override anything above.
[include]
	path = ~/.config/git/local
