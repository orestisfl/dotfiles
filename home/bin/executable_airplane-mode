#!/bin/bash
# airplane-mode - one-off maximal battery-saving power profile + radios off.
# Transient: pushed onto the running TLP via `tlp start -- PARAM=value`, so a
# reboot or `airplane-mode off` reverts it. State flag in $XDG_RUNTIME_DIR.
set -euo pipefail

flag="${XDG_RUNTIME_DIR:-/tmp}/airplane-mode"

overrides=(
    CPU_ENERGY_PERF_POLICY_ON_AC=power
    CPU_ENERGY_PERF_POLICY_ON_BAT=power
    PLATFORM_PROFILE_ON_AC=low-power
    PLATFORM_PROFILE_ON_BAT=low-power
    CPU_SCALING_GOVERNOR_ON_AC=powersave
    CPU_SCALING_GOVERNOR_ON_BAT=powersave
    CPU_BOOST_ON_AC=0
    CPU_BOOST_ON_BAT=0
    CPU_HWP_DYN_BOOST_ON_AC=0
    CPU_HWP_DYN_BOOST_ON_BAT=0
    CPU_MAX_PERF_ON_AC=50
    CPU_MAX_PERF_ON_BAT=50
)

have() { command -v "$1" >/dev/null 2>&1; }

notify() {
    have notify-send && notify-send --expire-time=3000 --replace-id=3720 "$@" || true
}

is_on() { [[ -f "$flag" ]]; }

net_off() {
    have nmcli || return 0
    nmcli radio all off || true
    nmcli networking off || true
}

net_on() {
    have nmcli || return 0
    nmcli networking on || true
    nmcli radio all on || true
}

turn_on() {
    have tlp || { echo "tlp not installed" >&2; return 1; }
    pkexec tlp start -- "${overrides[@]}" >/dev/null
    : >"$flag"
    net_off
    notify "Airplane mode on" "Max battery saving, networking off"
}

turn_off() {
    have tlp || { echo "tlp not installed" >&2; return 1; }
    pkexec tlp start >/dev/null
    rm -f "$flag"
    net_on
    notify "Airplane mode off" "Normal power profile, networking on"
}

case "${1:-toggle}" in
on)
    turn_on
    ;;
off)
    turn_off
    ;;
toggle)
    if is_on; then turn_off; else turn_on; fi
    ;;
status)
    # Exit status reports the mode: 0 = on, 1 = off (mirrors sway-idle).
    if is_on; then echo on; else echo off; exit 1; fi
    ;;
*)
    echo "usage: ${0##*/} {on|off|toggle|status}" >&2
    exit 2
    ;;
esac
